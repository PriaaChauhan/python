    {
      "parameters": {
        "jsCode": "\nconst ticket = $('Code').first().json;\n\nconst documents = $input.all()\n  .map(item => {\n    const result = item.json;\n    const document = result.document ?? result;\n\n    return {\n      score: result.score ?? null,\n      content: document.pageContent ?? document.content ?? ''\n    };\n  })\n  .filter(doc => doc.content.trim() !== '');\n\nconst retrievedContext = documents\n  .map((doc, i) =>\n    `Document ${i + 1}:\\n${doc.content}`\n  )\n  .join('\\n\\n---\\n\\n');\n\nreturn [{\n  json: {\n    ...ticket,\n    retrievedContext,\n    documentsFound: documents.length\n  }\n}];\n "
      },
