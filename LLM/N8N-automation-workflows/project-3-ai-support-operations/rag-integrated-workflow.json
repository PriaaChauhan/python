    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ticketId = String($json.ticketId ?? \"\").trim();\nconst customerEmail = String($json.customerEmail ?? \"\").trim().toLowerCase();\nconst message = String($json.message ?? \"\").trim();\nconst source = String($json.source ?? \"webhook\").trim();\n\nif (!ticketId || !customerEmail || !message) {\n  throw new Error(\"Required ticket fields are missing\");\n}\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(customerEmail)) {\n  throw new Error(\"Invalid customer email\");\n}\n\nreturn {\n  json: {\n    ticketId,\n    customerEmail,\n    message,\n    source,\n    receivedAt: new Date().toISOString(),\n    status: \"received\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        -656
      ],
      "id": "feaec9d9-7beb-40c3-974e-d36350300fd8",
      "name": "Code",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "=\n{{\n  JSON.stringify((() => {\n    const nodes = [\n      'High Priority', 'High Priority1',\n      'High Priority2', 'High Priority3',\n      'Normal Priority', 'Normal Priority1',\n      'Normal Priority2', 'Normal Priority3'\n    ];\n\n    const current = nodes.find(name => {\n      try {\n        return $(name).isExecuted;\n      } catch (e) {\n        return false;\n      }\n    });\n\n    const routed = current ? $(current).item.json : {};\n\n    return {\n      success: true,\n      message: \"Ticket classified, routed, and saved successfully\",\n      data: {\n        ticketId: $('Code').item.json.ticketId,\n        customerEmail: $('Code').item.json.customerEmail,\n        category: $('AI Agent').item.json.output.category,\n        priority: $('AI Agent').item.json.output.priority,\n        sentiment: $('AI Agent').item.json.output.sentiment,\n        summary: $('AI Agent').item.json.output.summary,\n        assignedTeam: routed.assignedTeam,\n        handlingType: routed.handlingType,\n        ticketStatus: routed.ticketStatus,\n        urgency: routed.urgency\n      }\n    };\n  })())\n}}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        2928,
